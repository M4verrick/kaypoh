# Copy to .env (Bun loads it automatically). Never commit .env.
ANTHROPIC_API_KEY=
TINYFISH_API_KEY=
# Photon Spectrum project (dashboard -> Settings). Leave unset to run terminal-only.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Knobs (defaults shown)
# KAYPOH_MODEL=claude-opus-5-5
# KAYPOH_DEBOUNCE_MS=2000
# KAYPOH_JUDGE_MODEL=claude-opus-5-5   # model for watch checks; a cheaper one is fine here
# KAYPOH_MAX_AGENT_RUNS_PER_DAY=10
# KAYPOH_AGENT_MAX_SECONDS=180
# KAYPOH_TZ=Asia/Singapore
# KAYPOH_DB=kaypoh.sqlite
